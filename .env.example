# ============================================================
# ERYES DASH 環境変数一覧
# すべて未設定でも「デモモード」（メモリ内データ＋LINEモック）で動作します。
# 本番運用時は .env.local（ローカル）/ Vercel の環境変数に設定してください。
# ============================================================

# ---- アプリ基本設定 ----
# セッションCookieの署名鍵（本番では必ずランダムな長い文字列に変更）
# 生成例: openssl rand -hex 32
AUTH_SECRET=

# 定時バッチ(/api/cron/reminder)の認証トークン。Vercel Cron が自動で付与する値と一致させる
# 生成例: openssl rand -hex 16
CRON_SECRET=

# アプリの公開URL（リッチメニュー設定やREADME手順で使用）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase（未設定の場合はメモリ内デモデータで動作）----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- LINE Messaging API（未設定の場合はモック送信＝画面・ログで確認できる）----
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---- LIFF（カウンセリングフォーム）----
# 未設定の場合、フォームはデモモード（テスト用ユーザーIDを手入力）で動作
NEXT_PUBLIC_LIFF_ID=

# ---- Anthropic（ENiの議事録AI整形。未設定の場合はテンプレート整形にフォールバック）----
# https://console.anthropic.com/ で発行したAPIキー
ANTHROPIC_API_KEY=
# 使用モデル（未設定なら claude-opus-5）
ANTHROPIC_MODEL=

# ---- AIしもん（スタッフの壁打ち相談AI。上の ANTHROPIC_API_KEY を使う）----
# 使用モデル（未設定なら claude-sonnet-5。しもん側の推奨は Sonnet）
AI_SHIMON_MODEL=
# "full" にすると 01_システムプロンプト.md の代わりに 03_フル版SKILL.md を土台にする
# ※ 現在は空のまま（＝01）を推奨。03 は 2026-09-10 の語り口見直し（驚く・「じゃん」・突き放し・
#    語尾の入れ替え）が入っておらず、関西弁を3語に絞った旧ルールのまま。full にすると
#    「マイルドすぎる」を直した内容が戻ります
AI_SHIMON_PROMPT=

# ---- ホームの朝の画面「今日のタスク」（上の ANTHROPIC_API_KEY を使う。1人1日1回だけ作って保存）----
# 使用モデル（未設定なら上の ANTHROPIC_MODEL と同じ）。費用を抑えたい場合は、軽いモデルのIDを入れて変えられます
# キーが未設定なら、AIを使わない普通の一覧で出ます
HOME_BRIEF_MODEL=

# ---- 通知（Web Push）・ホーム画面アプリのバッジ ----
# 鍵の作り方: npx web-push generate-vapid-keys  → Public Key / Private Key を貼る
# 未設定なら通知の案内は出ず、他の機能はそのまま動く
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 連絡先（mailto:メールアドレス か https://のURL。未設定なら NEXT_PUBLIC_APP_URL）
VAPID_SUBJECT=

# ============================================================
# 2026-11 依頼10〜23（追加開発）。どれも未設定のままでも画面はエラーにならず、その機能だけが止まります
# ============================================================
# 本番のデータに触らずに試すとき（Vercel の Preview の環境変数にだけ入れる）。1 で見本のデータ（デモ）で動く
DEMO_MODE=
# 追加したAIの機能（Wiki検索・今週やること）のモデル。未設定なら AI_SHIMON_MODEL と同じ（キーは ANTHROPIC_API_KEY）
AI_TOOLS_MODEL=
# SalonOne のAPI（仕様が届いてから。未設定の間は手入力・日報の数字で動く）
SALONONE_API_BASE=
SALONONE_API_KEY=
# カリキュラム動画・面接の録画の配信（推奨：Cloudflare Stream）。未設定なら Supabase Storage の非公開バケット
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# Supabase Storage を使うときのバケット名（非公開。無ければアプリが作る）
SUPABASE_VIDEO_BUCKET=curriculum-videos
# Instagram（Metaの開発者の画面 → Instagram → Instagramログインによる API の設定の「アプリID・シークレット」）
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
